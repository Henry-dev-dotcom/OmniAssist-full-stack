# Local development only. Never put production secrets here.
OMNI_ENV=development
OMNI_DATABASE_URL=postgresql://omni:omni@localhost:5432/omniassist
OMNI_REDIS_URL=redis://localhost:6379/0
OMNI_CORS_ORIGINS=["http://localhost:8080"]
# Sign-in: "local" (built-in email/password, decision 0002) or "oidc" (decision 0001).
OMNI_AUTH_PROVIDER=local
# Required in production: 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# OMNI_AUTH_LOCAL_SECRET=
