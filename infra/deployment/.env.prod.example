# Copy to .env.prod (git-ignored) and fill in. Never commit real values.
# The public host name; DNS must point at this machine for HTTPS to work.
DOMAIN=omniassist.example.com
# Long random values, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
AUTH_LOCAL_SECRET=
# Optional: phone and desktop notifications. Generate once with
#   docker compose ... run --rm api uv run --no-sync python -m src.infrastructure.notifications.webpush
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
